            }
        }
    }

    # Admin interface
    handle /Marti/* {
        reverse_proxy tak:8446 {
            transport http {
                tls_insecure_skip_verify   # TAK uses self-signed internally
            }
        }
    }

    # Health check
    handle /health {
        respond "OK" 200
